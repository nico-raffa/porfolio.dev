---
/**
 * Circuito de la orden de compra: seis estados, un ledger append-only que
 * registra cada transición, y el storno como única forma de anular.
 */
import './diagram.css';
import type { Lang } from '../../data/cv';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = useTranslations(lang).diagrams.purchaseOrder;

const W = 108;
const GAP = 14;
const X0 = 14;
const Y = 30;
const H = 46;

const states = d.states.map((label, i) => ({ label, x: X0 + i * (W + GAP) }));
const last = states[states.length - 1];
const right = last.x + W;
---

<div class="dg-wrap">
  <svg
    class="dg"
    viewBox="0 0 746 212"
    style="min-width: 660px"
    role="img"
    aria-labelledby="dg-po-t dg-po-d"
  >
    <title id="dg-po-t">{d.title}</title>
    <desc id="dg-po-d">{d.desc}</desc>

    <defs>
      <marker id="dg-po-h" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path class="dg-head" d="M0 0 L8 4 L0 8 z" />
      </marker>
      <marker id="dg-po-ha" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path class="dg-head-accent" d="M0 0 L8 4 L0 8 z" />
      </marker>
    </defs>

    {
      states.map((s, i) => (
        <>
          <rect class:list={[i === 0 || i === states.length - 1 ? 'dg-box-accent' : 'dg-box']} x={s.x} y={Y} width={W} height={H} rx="3" />
          <text class="dg-label" x={s.x + W / 2} y={Y + H / 2}>{s.label}</text>
          {i < states.length - 1 && (
            <path class="dg-line" marker-end="url(#dg-po-h)" d={`M${s.x + W} ${Y + H / 2} H${s.x + W + GAP - 2}`} />
          )}
          {/* Cada transición baja al ledger */}
          <path class="dg-line-dash" d={`M${s.x + W / 2} ${Y + H} V116`} />
        </>
      ))
    }

    <!-- Ledger: escribe, nunca reescribe -->
    <rect class="dg-box" x={X0} y="116" width={right - X0} height="34" rx="3" />
    <text class="dg-label" x={(X0 + right) / 2} y="133">{d.ledger}</text>

    <!-- Storno: la anulación vuelve al principio y también queda escrita -->
    <path
      class="dg-line-accent"
      marker-end="url(#dg-po-ha)"
      d={`M${right - W / 2} 150 V178 H${X0 + W / 2} V${Y + H + 4}`}
    />
    <text class="dg-note" x={(X0 + right) / 2} y="192">{d.storno}</text>
  </svg>
</div>
