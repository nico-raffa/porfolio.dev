---
/**
 * Barra superior. Aparece cuando el encabezado sale de pantalla (el sentinel
 * lo marca desde la página). En el portafolio lleva la navegación por anclas y
 * el CTA primario compacto; en el CV, sólo el enlace de vuelta.
 */
import { Mail } from 'lucide-astro';
import Controls from './Controls.astro';
import { profile, type Lang } from '../data/cv';
import { useTranslations, homeHref, type Page } from '../i18n';

interface Props {
  lang: Lang;
  page?: Page;
}
const { lang, page = 'home' } = Astro.props;
const t = useTranslations(lang);

const anchors = [
  { href: '#casos', label: t.nav.sections.cases },
  { href: '#stack', label: t.nav.sections.stack },
  { href: '#experiencia', label: t.nav.sections.experience },
  { href: '#contacto', label: t.nav.sections.contact },
];
---

<div
  data-topbar
  class="no-print fixed inset-x-0 top-0 z-40 -translate-y-full border-b border-rule bg-paper/90 backdrop-blur transition-transform duration-200 data-[shown]:translate-y-0"
>
  <div class="mx-auto flex max-w-5xl items-center gap-4 px-5 py-1.5 sm:px-8">
    <p class="min-w-0 shrink truncate">
      <a href={homeHref(lang)} class="font-display text-lg" title={t.nav.portfolioTitle}>{profile.name}</a>
    </p>

    {
      page === 'home' ? (
        <nav class="ml-auto hidden md:block" aria-label={t.nav.sections.cases}>
          <ul class="flex items-center gap-5">
            {anchors.map((a) => (
              <li>
                <a href={a.href} class="label hover:text-accent">
                  {a.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ) : (
        <p class="ml-auto hidden md:block">
          <a href={homeHref(lang)} class="label hover:text-accent" title={t.nav.portfolioTitle}>
            {t.nav.portfolio}
          </a>
        </p>
      )
    }

    <div class="ml-auto flex items-center gap-2 md:ml-4">
      {
        page === 'home' && (
          <a
            href={`mailto:${profile.email}`}
            class="btn btn-primary hidden !min-h-9 !px-3 sm:inline-flex"
            title={t.cta.writeTitle}
          >
            <Mail class="h-3.5 w-3.5" aria-hidden="true" />
            {t.cta.write}
          </a>
        )
      }
      <Controls lang={lang} page={page} />
    </div>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-topbar]');
  /* El sentinel es el encabezado entero, no un div de 1px: un salto de scroll
     (un enlace de ancla, por ejemplo) puede pasar por encima de 1px sin que el
     observer llegue a ver el estado intermedio y la barra queda trabada. El
     encabezado, en cambio, está siempre en el tope del documento, así que en la
     carga intersecta y cada entrada y salida dispara la notificación. */
  const sentinel = document.querySelector('[data-topbar-sentinel]');
  if (bar && sentinel) {
    new IntersectionObserver(([entry]) => {
      bar.toggleAttribute('data-shown', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>
