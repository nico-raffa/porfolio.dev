---
import { MapPin, Phone, Linkedin, Github } from 'lucide-astro';
import Row from './Row.astro';
import Controls from './Controls.astro';
import CopyEmail from './CopyEmail.astro';
import { profile, type Lang } from '../data/cv';
import { photoSrc } from '../data/photo';
import { useTranslations } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header data-topbar-sentinel class="mx-auto max-w-5xl px-5 sm:px-8">
  <div class="flex justify-end py-3">
    <Controls lang={lang} page="cv" />
  </div>

  <Row class="pb-10" stickyRail={false}>
    <div slot="rail" class="mb-5 lg:mb-0">
      {
        photoSrc ? (
          <img
            src={photoSrc}
            alt={t.identity.photoAlt}
            width="144"
            height="144"
            decoding="async"
            class="h-28 w-28 rounded-sm object-cover lg:h-36 lg:w-36"
          />
        ) : (
          <div
            class="flex h-28 w-28 items-center justify-center rounded-sm border border-rule bg-surface lg:h-36 lg:w-36"
            aria-hidden="true"
          >
            <span class="font-display text-4xl tracking-tight text-ink-2 lg:text-5xl">{profile.initials}</span>
          </div>
        )
      }
    </div>

    <h1 class="font-display text-[clamp(2.5rem,7vw,3.75rem)] leading-[1.05] font-medium">
      {profile.name}
    </h1>

    <p class="mt-2 text-lg font-medium sm:text-xl">{t.identity.role}</p>

    <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-2">
      <span class="inline-flex items-center gap-1.5">
        <MapPin class="h-3.5 w-3.5" aria-hidden="true" />
        {profile.location}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {t.identity.availability}
      </span>
    </p>

    <p class="mt-6 text-[1.0625rem] leading-relaxed sm:text-lg">{t.identity.positioning}</p>

    <ul class="mt-6 flex flex-col gap-2 text-[0.9375rem] text-ink-2 sm:flex-row sm:flex-wrap sm:gap-x-6">
      <li><CopyEmail lang={lang} /></li>
      <li class="inline-flex items-center gap-1.5">
        <Phone class="h-3.5 w-3.5" aria-hidden="true" />
        <a href={profile.phoneHref} class="link">{profile.phone}</a>
        <a href={profile.whatsapp} class="link no-print" rel="noopener">{t.identity.whatsapp}</a>
      </li>
      <li class="inline-flex items-center gap-1.5">
        <Linkedin class="h-3.5 w-3.5" aria-hidden="true" />
        <a href={profile.linkedin} class="link" rel="noopener">{profile.linkedinLabel}</a>
      </li>
      <li class="inline-flex items-center gap-1.5">
        <Github class="h-3.5 w-3.5" aria-hidden="true" />
        <a href={profile.github} class="link" rel="noopener">{profile.githubLabel}</a>
      </li>
    </ul>
  </Row>
</header>
