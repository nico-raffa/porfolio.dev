---
import { Sun, Moon, Download } from 'lucide-astro';
import { pdf, type Lang } from '../data/cv';
import { useTranslations, otherLang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  /** Para que el switch de idioma quede en la misma página, no en el home. */
  page?: Page;
}
const { lang, page = 'home' } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang, page);
const btn =
  'inline-flex h-11 items-center gap-1.5 rounded-sm px-2.5 text-ink-2 transition-colors hover:text-ink hover:bg-band cursor-pointer';
---

<div class="no-print flex items-center gap-0.5">
  <a href={other.href} hreflang={other.lang} lang={other.lang} title={t.meta.switchTo} class:list={[btn, 'label']}>
    {t.meta.otherLangShort}
  </a>

  <button type="button" data-theme-toggle class={btn} title={t.nav.theme} aria-label={t.nav.theme}>
    <Sun class="hidden h-4 w-4 dark:block" aria-hidden="true" />
    <Moon class="block h-4 w-4 dark:hidden" aria-hidden="true" />
  </button>

  <a href={pdf[lang]} download title={t.nav.downloadTitle} class:list={[btn, 'label']}>
    <Download class="h-4 w-4" aria-hidden="true" />
    <span class="hidden sm:inline">{t.nav.download}</span>
  </a>
</div>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        /* almacenamiento bloqueado: el tema dura lo que dura la pestaña */
      }
    });
  });
</script>
