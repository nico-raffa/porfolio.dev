---
import { ChevronRight } from 'lucide-astro';
import { inlineCode } from '../i18n/markup';

interface Props {
  label: string;
  items: string[];
}
const { label, items } = Astro.props;
---

<details class="mt-4 border-t border-rule pt-1">
  <summary class="label inline-flex min-h-11 items-center gap-1.5 hover:text-accent">
    <ChevronRight class="marker h-3.5 w-3.5" aria-hidden="true" />
    {label}
  </summary>
  <ul class="details-body mt-1 space-y-2.5 text-[0.9375rem] leading-relaxed text-ink-2">
    {
      items.map((item) => (
        <li class="border-l border-rule pl-3" set:html={inlineCode(item)} />
      ))
    }
  </ul>
</details>
